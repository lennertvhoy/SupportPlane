// SupportPlane MVP 1 Prisma Schema
// This schema expresses tenant boundaries, core entities, and audit foundations.
// Migrations are deferred until the migration system is explicitly initialized.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  roles               Role[]
  supportSessions     SupportSession[]
  ticketingAdapters   TicketingAdapter[]
  customerReferences  CustomerReference[]
  ticketReferences    TicketReference[]
  ticketSummaries     TicketSummary[]
  connectorInstallations ConnectorInstallation[]
  aiContextPackets    AIContextPacket[]
  screenObservations  ScreenObservation[]
  policyDecisions     PolicyDecision[]
  auditEvents         AuditEvent[]
  localAuthSessions   LocalAuthSession[]
  callEvents          CallEvent[]
  callRecordings      CallRecording[]
  internalNoteDrafts  InternalNoteDraft[]
  supportActions      SupportAction[]
  actionOutboxItems   ActionOutboxItem[]
  actionOutboxAttempts ActionOutboxAttempt[]
  sharingStates       SharingState[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  permissions String[] @default([])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model User {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  name       String
  status     String    @default("active")
  passwordHash String?
  lastLoginAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles             Role[]
  assignedSessions  SupportSession[]   @relation("AssignedUser")
  auditEvents       AuditEvent[]       @relation("ActorUser")
  policyDecisions   PolicyDecision[]
  localAuthSessions LocalAuthSession[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([status])
  @@map("users")
}

model LocalAuthSession {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@map("local_auth_sessions")
}

model SupportSession {
  id                   String   @id @default(cuid())
  tenantId             String
  status               String   @default("open")
  priority             String   @default("normal")
  title                String
  description          String?
  assignedUserId       String?
  linkedTicketIds      String[] @default([])
  aiContextPacketIds   String[] @default([])
  screenObservationIds String[] @default([])
  callEventIds         String[] @default([])
  auditEventIds        String[] @default([])
  startedAt            DateTime @default(now())
  endedAt              DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser      User?              @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  aiContextPackets  AIContextPacket[]
  screenObservations ScreenObservation[]
  policyDecisions   PolicyDecision[]
  auditEvents       AuditEvent[]
  callEvents        CallEvent[]
  callRecordings    CallRecording[]
  internalNoteDrafts InternalNoteDraft[]
  supportActions    SupportAction[]
  actionOutboxItems ActionOutboxItem[]
  sharingStates     SharingState[]
  ticketSummaries   TicketSummary[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([assignedUserId])
  @@index([startedAt])
  @@map("support_sessions")
}

model TicketingAdapter {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  adapterType        String
  capabilities       String[] @default([])
  status             String   @default("active")
  config             Json     @default("{}")
  secretReferenceIds String[] @default([])
  lastSyncAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerReferences CustomerReference[]
  ticketReferences TicketReference[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("ticketing_adapters")
}

model CustomerReference {
  id                String   @id @default(cuid())
  tenantId          String
  adapterId         String
  externalCustomerId String
  name              String?
  email             String?
  phone             String?
  company           String?
  rawData           Json?
  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adapter          TicketingAdapter @relation(fields: [adapterId], references: [id], onDelete: Cascade)
  ticketReferences TicketReference[]

  @@unique([tenantId, adapterId, externalCustomerId])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("customer_references")
}

model TicketReference {
  id               String   @id @default(cuid())
  tenantId         String
  adapterId        String
  externalTicketId String
  subject          String
  status           String   @default("unknown")
  priority         String   @default("normal")
  customerId       String?
  customerEmail    String?
  customerName     String?
  rawData          Json?
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adapter  TicketingAdapter  @relation(fields: [adapterId], references: [id], onDelete: Cascade)
  customer CustomerReference? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticketSummaries TicketSummary[]

  @@unique([tenantId, adapterId, externalTicketId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([externalTicketId])
  @@index([customerId])
  @@map("ticket_references")
}

model TicketSummary {
  id                String   @id @default(cuid())
  tenantId          String
  ticketReferenceId String
  sessionId         String?
  generatedBy       String?
  summaryText       String?
  keyPoints         String[] @default([])
  sentiment         String?
  source            String
  redactionLog      Json     @default("[]")
  mockDevOnly       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketReference TicketReference @relation(fields: [ticketReferenceId], references: [id], onDelete: Cascade)
  session         SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, ticketReferenceId])
  @@index([tenantId, sessionId])
  @@map("ticket_summaries")
}

model ConnectorInstallation {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  adapterType       String
  config            Json     @default("{}")
  secretReferenceIds String[] @default([])
  status            String   @default("inactive")
  safetyFlags       Json     @default("{}")
  lastVerifiedAt    DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("connector_installations")
}

model AIContextPacket {
  id                    String   @id @default(cuid())
  tenantId              String
  sessionId             String
  provenance            String
  sourceTicketIds       String[] @default([])
  sourceAdapterId       String?
  payload               Json
  redactionLog          Json     @default("[]")
  contextHash           String?
  modelPolicySnapshotId String?
  createdAt             DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([provenance])
  @@index([createdAt])
  @@map("ai_context_packets")
}

model ScreenObservation {
  id                   String   @id @default(cuid())
  tenantId             String
  sessionId            String
  callEventId          String?
  source               String
  kind                 String
  status               String   @default("review_required")
  rawInputPlaceholder  String?
  redactedSummary      String?
  appLabel             String?
  windowLabel          String?
  urlLabel             String?
  sharingState         String   @default("inactive")
  rawImageRetention    String   @default("disabled")
  redactionStatus      String   @default("not_needed")
  safetyFlags          Json     @default("{}")
  noRawPixels          Boolean  @default(true)
  noClipboard          Boolean  @default(true)
  noOcr                Boolean  @default(true)
  noCredentialCapture  Boolean  @default(true)
  mockDevOnly          Boolean  @default(true)
  reviewedAt           DateTime?
  reviewedBy           String?
  contextPacketId      String?
  createdAt            DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([kind])
  @@index([createdAt])
  @@map("screen_observations")
}

model SharingState {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  state     String   @default("inactive")
  mockDevOnly Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionId])
  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@map("sharing_states")
}

model PolicyDecision {
  id                     String   @id @default(cuid())
  tenantId               String
  sessionId              String?
  outcome                String
  action                 String
  resourceType           String
  resourceId             String
  actorUserId            String?
  reason                 String
  evidence               Json     @default("{}")
  toolManifestSnapshotId String?
  riskLevel              String?
  createdAt              DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([outcome])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("policy_decisions")
}

model AuditEvent {
  id                String   @id @default(cuid())
  tenantId          String
  sessionId         String?
  eventType         String
  actorType         String
  actorId           String
  action            String
  resourceType      String
  resourceId        String
  metadata          Json     @default("{}")
  hashChainPrevious String?
  integrityHash     String?
  createdAt         DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?           @relation("ActorUser", fields: [actorId], references: [id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([eventType])
  @@index([actorType, actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_events")
}

model CallEvent {
  id            String   @id @default(cuid())
  tenantId      String
  sessionId     String?
  provider      String
  source        String
  externalCallId String
  direction     String
  status        String
  caller        Json     @default("{}")
  callerMatch   Json?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  answeredAt    DateTime?
  metadata      Json     @default("{}")
  mockDevOnly   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  recordings CallRecording[]

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([externalCallId])
  @@index([status])
  @@index([createdAt])
  @@map("call_events")
}

model CallRecording {
  id                  String   @id @default(cuid())
  tenantId            String
  callEventId         String
  supportSessionId    String?
  source              String
  status              String
  durationSeconds     Int?
  mockMediaUrl        String?
  placeholderReference String?
  storageType         String
  checksumHash        String?
  reviewedAt          DateTime?
  reviewedBy          String?
  updatedAt           DateTime?
  mockDevOnly         Boolean  @default(true)
  complianceDisclaimer String?
  noRealAudio         Boolean  @default(true)
  createdAt           DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  call    CallEvent       @relation(fields: [callEventId], references: [id], onDelete: Cascade)
  session SupportSession? @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, callEventId])
  @@index([supportSessionId])
  @@index([createdAt])
  @@map("call_recordings")
}

model InternalNoteDraft {
  id               String   @id @default(cuid())
  tenantId         String
  sessionId        String
  externalTicketId String
  subject          String?
  body             String
  reviewed         Boolean  @default(false)
  reviewerId       String?
  createdAt        DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([externalTicketId])
  @@map("internal_note_drafts")
}

model SupportAction {
  id                      String   @id @default(cuid())
  tenantId                String
  sessionId               String
  callEventId             String?
  customerReferenceId     String?
  ticketReferenceId       String?
  connectorInstallationId String?
  actionType              String
  status                  String   @default("draft")
  idempotencyKey          String
  requestedBy             String
  submittedAt             DateTime?
  reviewedBy              String?
  reviewDecision          String?
  reviewReason            String?
  reviewedAt              DateTime?
  queuedAt                DateTime?
  mockDeliveredAt         DateTime?
  failureReason           String?
  payloadSummary          Json     @default("{}")
  safeBodyPreview         String?
  mockDevOnly             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      SupportSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  outboxItems  ActionOutboxItem[]
  attempts     ActionOutboxAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, status])
  @@index([actionType])
  @@index([createdAt])
  @@map("support_actions")
}

model ActionOutboxItem {
  id                      String   @id @default(cuid())
  tenantId                String
  supportActionId         String
  sessionId               String
  connectorInstallationId String?
  actionType              String
  status                  String   @default("queued")
  idempotencyKey          String
  deliveryMode            String   @default("mock")
  deliveryIntent          Json     @default("{}")
  attemptCount            Int      @default(0)
  maxAttempts             Int      @default(3)
  latestAttemptState      String?
  queuedAt                DateTime @default(now())
  nextAttemptAt           DateTime?
  processingStartedAt     DateTime?
  workerLockId            String?
  workerLockedAt          DateTime?
  workerLockExpiresAt     DateTime?
  mockDeliveredAt         DateTime?
  failedAt                DateTime?
  retryScheduledAt        DateTime?
  deadLetteredAt          DateTime?
  cancelledAt             DateTime?
  lastError               String?
  lastErrorCode           String?
  lastErrorMessage        String?
  lastErrorRedacted       Boolean  @default(true)
  deadLetterReason        String?
  safetyFlags             Json     @default("{}")
  mockDevOnly             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session       SupportSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  supportAction SupportAction         @relation(fields: [supportActionId], references: [id], onDelete: Cascade)
  attempts      ActionOutboxAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, sessionId])
  @@index([tenantId, supportActionId])
  @@index([tenantId, workerLockExpiresAt])
  @@index([tenantId, connectorInstallationId])
  @@index([queuedAt])
  @@map("action_outbox_items")
}

model ActionOutboxAttempt {
  id              String   @id @default(cuid())
  tenantId        String
  outboxItemId    String
  supportActionId String
  attemptNumber   Int
  state           String
  deliveryResult  Json     @default("{}")
  errorCode       String?
  errorMessage    String?
  errorRedacted   Boolean  @default(true)
  attemptedAt     DateTime @default(now())
  completedAt     DateTime?
  mockDevOnly     Boolean  @default(true)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outboxItem    ActionOutboxItem @relation(fields: [outboxItemId], references: [id], onDelete: Cascade)
  supportAction SupportAction    @relation(fields: [supportActionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, outboxItemId])
  @@index([tenantId, supportActionId])
  @@index([attemptedAt])
  @@unique([tenantId, outboxItemId, attemptNumber])
  @@map("action_outbox_attempts")
}
