# SupportPlane local development environment
# Copy to .env and adjust values as needed.
# These defaults match the local Podman/Docker compose topology (BL-006).

# ------------------------------------------------------------------
# API (NestJS)
# ------------------------------------------------------------------
API_PORT=4110

# ------------------------------------------------------------------
# Web (Next.js)
# ------------------------------------------------------------------
PORT=3200
NEXT_PUBLIC_API_BASE_URL=http://localhost:4110

# ------------------------------------------------------------------
# Database (PostgreSQL via local compose)
# ------------------------------------------------------------------
# Host port 5434 is mapped to container port 5432 to avoid conflicts
# with existing PostgreSQL instances on the host.
DATABASE_URL=postgresql://supportplane:supportplane_dev@localhost:5434/supportplane?schema=public

# ------------------------------------------------------------------
# NATS
# ------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# ------------------------------------------------------------------
# Object Storage (MinIO via local compose)
# ------------------------------------------------------------------
# MinIO API endpoint
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=supportplane
MINIO_SECRET_KEY=supportplane_dev
# MinIO Console (web UI) is available at http://localhost:9001

# ------------------------------------------------------------------
# Zammad Connector (optional — mock mode is the safe default)
# ------------------------------------------------------------------
# Set to "zammad" to enable real Zammad integration. "mock" is default.
ZAMMAD_CONNECTOR_MODE=mock
# ZAMMAD_BASE_URL=https://zammad.example.com
# ZAMMAD_API_TOKEN=your_personal_access_token
