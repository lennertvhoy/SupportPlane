{
  "name": "supportplane",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant, self-hostable AI support cockpit",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "test": "npm run test --workspaces --if-present",
    "validate": "node scripts/validate-contracts.js && npx prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "health": "node scripts/health.js",
    "ci": "npm run build && npm run format:check && npm run lint && npm run typecheck && npm run validate && npm test && npm run security:baseline",
    "ci:local": "npm run ci",
    "ci:full": "npm run ci && npm run check:docs-governance",
    "security:baseline": "bash scripts/security-baseline.sh",
    "check:runtime-identity": "bash scripts/check_runtime_identity.sh",
    "check:evidence-hygiene": "bash scripts/check_evidence_hygiene.sh",
    "check:docs-governance": "python3 scripts/check_state_docs.py && python3 scripts/check_docs_hygiene.py"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "image-size": "^2.0.2",
    "playwright": "^1.59.1",
    "prettier": "^3.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  }
}
