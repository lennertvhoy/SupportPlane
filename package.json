{
  "name": "supportplane",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant, self-hostable AI support cockpit",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "test": "npm run test --workspaces --if-present",
    "validate": "node scripts/validate-contracts.js && npx prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "health": "node scripts/health.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
