{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "instructions": [
    "AGENTS.md",
    "STATUS.md",
    "PROJECT_STATE.yaml",
    "PROJECT_DNA.yaml",
    "NEXT_ACTIONS.md",
    "BACKLOG.md",
    "docs/EVIDENCE_LOG.md",
    ".opencode/skills/statedd-protocol/SKILL.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser=chrome"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": "allow",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.1
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1
    },
    "statedd-reviewer": {
      "description": "Reviews StateDD closure quality, repo hygiene, evidence mapping, stale claims, and acceptance docs without making edits.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.1",
      "temperature": 0.1
    },
    "browser-verifier": {
      "description": "Uses Playwright MCP and local commands to verify user-visible behavior, capture screenshots, inspect console/network issues, and produce evidence.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.1
    }
  }
}
