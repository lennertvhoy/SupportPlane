{
  "name": "@supportplane/api",
  "version": "0.1.0",
  "private": true,
  "description": "SupportPlane API (NestJS)",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsc && node --test dist/test/**/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@supportplane/audit": "*",
    "@supportplane/connectors": "*",
    "@supportplane/contracts": "*",
    "@supportplane/policy": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
