{
  "name": "@supportplane/api",
  "version": "0.1.0",
  "private": true,
  "description": "SupportPlane API (NestJS)",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsc && node --test-force-exit --test dist/test/**/*.test.js dist/src/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supportplane/ai": "*",
    "@supportplane/audit": "*",
    "@supportplane/connectors": "*",
    "@supportplane/contracts": "*",
    "@supportplane/policy": "*",
    "nats": "^2.29.3",
    "openid-client": "^6.8.4",
    "pdfmake": "^0.2.23",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
