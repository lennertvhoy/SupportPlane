# Explicit-copy local sandbox image for SupportPlane API
# Relies on local npm run build and prisma generate already being done.
FROM docker.io/library/node:22-slim
WORKDIR /app

# Copy root and workspace package manifests for deterministic install
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/contracts/package.json packages/contracts/
COPY packages/policy/package.json packages/policy/
COPY packages/connectors/package.json packages/connectors/
COPY packages/ai/package.json packages/ai/
COPY packages/audit/package.json packages/audit/
COPY packages/ui/package.json packages/ui/

# Install dependencies (layer cache hit when package.json unchanged)
RUN npm ci

# Copy pre-built dist, prisma generated client, and essential files
COPY apps/api/dist apps/api/dist
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/dist packages/contracts/dist
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/policy/dist packages/policy/dist
COPY packages/policy/package.json packages/policy/package.json
COPY packages/connectors/dist packages/connectors/dist
COPY packages/connectors/package.json packages/connectors/package.json
COPY packages/ai/dist packages/ai/dist
COPY packages/ai/package.json packages/ai/package.json
COPY packages/audit/dist packages/audit/dist
COPY packages/audit/package.json packages/audit/package.json
COPY packages/ui/dist packages/ui/dist
COPY packages/ui/package.json packages/ui/package.json
COPY prisma prisma
COPY tsconfig.json ./
COPY node_modules/.prisma node_modules/.prisma

# Runtime environment
ENV NODE_ENV=production
ENV API_PORT=4110
EXPOSE 4110
WORKDIR /app/apps/api
CMD ["node", "dist/src/main.js"]
