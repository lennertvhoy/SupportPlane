# Fast local sandbox image for SupportPlane Worker
# Relies on local npm run build already being done.
# Not production-grade.
FROM docker.io/library/node:22-slim
WORKDIR /app

# Copy root and workspace package manifests for deterministic install
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/contracts/package.json packages/contracts/
COPY packages/policy/package.json packages/policy/
COPY packages/connectors/package.json packages/connectors/
COPY packages/ai/package.json packages/ai/
COPY packages/audit/package.json packages/audit/
COPY packages/ui/package.json packages/ui/

# Install dependencies (layer cache hit when package.json unchanged)
RUN npm ci

# Copy full source and pre-built dist artifacts
COPY . .

# Runtime environment
ENV NODE_ENV=production
WORKDIR /app/apps/worker
CMD ["node", "dist/src/index.js", "loop"]
